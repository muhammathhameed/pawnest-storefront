NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dropship engine (server-only) ---
# Bearer token for POST/GET /api/jobs/run (worker tick). Use a long random value.
CRON_SECRET=
# 17TRACK API key: registers tracking numbers and verifies webhook signatures.
TRACKING_17TRACK_API_KEY=
# Per-supplier secrets are named by suppliers.api_key_ref / webhook_secret_ref
# and must start with SUPPLIER_, e.g.
# SUPPLIER_ALPHA_API_KEY=
# SUPPLIER_ALPHA_WEBHOOK_SECRET=
# Countries Stripe Checkout will accept a ship-to address for (ISO codes).
DROPSHIP_SHIP_COUNTRIES=US,CA,GB,AU
# Brand shown on blind packing slips and used as the return address.
DROPSHIP_BRAND_NAME=PawNest
DROPSHIP_SUPPORT_EMAIL=support@pawnest.example
DROPSHIP_RETURN_LINE1=
DROPSHIP_RETURN_CITY=
DROPSHIP_RETURN_POSTAL_CODE=
DROPSHIP_RETURN_COUNTRY=US
# Backup suppliers may not cut margin below this share of the sale price.
DROPSHIP_MIN_MARGIN=0.10
